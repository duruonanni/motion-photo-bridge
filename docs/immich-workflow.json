{
  "name": "Vivo 动态照片自动关联",
  "description": "资产入库时把 vivo 的 mp4 动态片段关联到同名 jpg 并隐藏视频(由 mpb serve 处理);真正的合并在定时任务 tools/auto_merge.py 里做,webhook 不改写文件。",
  "enabled": true,
  "trigger": "AssetCreate",
  "steps": [
    {
      "method": "immich-plugin-core#assetFileFilter",
      "config": {
        "pattern": "\\.mp4$",
        "matchType": "regex",
        "caseSensitive": false
      },
      "enabled": true
    },
    {
      "method": "immich-plugin-core#webhook",
      "config": {
        "url": "http://172.17.0.1:9100/immich/vivo-link",
        "method": "POST"
      },
      "enabled": true
    }
  ]
}
